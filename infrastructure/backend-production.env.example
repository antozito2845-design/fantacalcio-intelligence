# Fantacalcio Intelligence backend - production environment template
# Never place real production secrets in this tracked example file.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://YOUR_DB_HOST:5432/fantacalcio_intelligence
DATABASE_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DATABASE_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

APP_USER_USERNAME=REPLACE_WITH_USER_USERNAME
APP_USER_PASSWORD=REPLACE_WITH_STRONG_USER_PASSWORD

CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN

DATA_REFRESH_SCHEDULER_ENABLED=false
DATA_REFRESH_SCHEDULER_CRON=0 0 4 * * *
DATA_REFRESH_SCHEDULER_SEASON=2026/2027